diff --git a/osfmk/i386/linux_hosted_boot_memory.h b/osfmk/i386/linux_hosted_boot_memory.h
new file mode 100644
index 0000000..7609246
--- /dev/null
+++ b/osfmk/i386/linux_hosted_boot_memory.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: APSL-2.0 */
+#ifndef _I386_LINUX_HOSTED_BOOT_MEMORY_H_
+#define _I386_LINUX_HOSTED_BOOT_MEMORY_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define LINUX_HOSTED_PA_LIMIT (1ULL << 32)
+#define LINUX_HOSTED_LARGE_PAGE (1ULL << 21)
+
+struct linux_hosted_boot_memory {
+	uint64_t start;
+	uint64_t end;
+};
+
+static inline bool
+linux_hosted_boot_memory_init(struct linux_hosted_boot_memory *range,
+    uint64_t start, uint64_t size)
+{
+	if (!start || !size || ((start | size) & (LINUX_HOSTED_LARGE_PAGE - 1)) ||
+	    start >= LINUX_HOSTED_PA_LIMIT || size > LINUX_HOSTED_PA_LIMIT - start) {
+		return false;
+	}
+	range->start = start;
+	range->end = start + size;
+	return true;
+}
+
+static inline bool
+linux_hosted_boot_contains(const struct linux_hosted_boot_memory *range,
+    uint64_t pa, uint64_t bytes)
+{
+	return bytes && pa >= range->start && pa < range->end &&
+	       bytes <= range->end - pa;
+}
+
+static inline bool
+linux_hosted_boot_allocate(const struct linux_hosted_boot_memory *range,
+    uint64_t pa, uint64_t bytes)
+{
+	/* first_avail is computed with ID_MAP_VTOP(), which discards bit 32. */
+	return linux_hosted_boot_contains(range, pa, bytes) &&
+	       bytes < LINUX_HOSTED_PA_LIMIT - pa;
+}
+
+#endif /* _I386_LINUX_HOSTED_BOOT_MEMORY_H_ */
